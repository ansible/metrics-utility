# AWX dev image, built from the ../awx checkout requirements
#
# Only dependencies live in the image - awx code, config, bootstrap and supervisor
# config are all mounted by docker-compose.yaml, so the image only needs a rebuild
# when awx requirements change.
#
# build context "awx-src" is the awx checkout (see additional_contexts in compose)

ARG RECEPTOR_IMAGE=quay.io/ansible/receptor:devel

FROM ${RECEPTOR_IMAGE} AS receptor

FROM quay.io/centos/centos:stream9

ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8
ENV AWX_LOGGING_MODE=stdout
ENV HOME=/var/lib/awx
ENV PATH=/var/lib/awx/venv/awx/bin:${PATH}

RUN dnf -y install 'dnf-command(config-manager)' && \
    dnf config-manager --set-enabled crb && \
    dnf -y install \
      crun \
      gcc \
      gcc-c++ \
      git-core \
      glibc-langpack-en \
      libffi-devel \
      libtool-ltdl-devel \
      make \
      nginx \
      openssh-clients \
      openssl \
      patch \
      podman \
      postgresql \
      postgresql-devel \
      procps-ng \
      python3.12 \
      python3.12-devel \
      python3.12-pip \
      rsync \
      slirp4netns \
      swig \
      xmlsec1-devel \
      xmlsec1-openssl-devel && \
    dnf -y install epel-release && \
    dnf -y install inotify-tools && \
    dnf -y clean all

# podman for running jobs in execution environments - no systemd in here, no cgroups
# (not writable when nested in rootless podman), and only fully qualified image names
# (an unqualified one would hang on a prompt)
RUN printf '[containers]\ncgroups = "disabled"\n\n[engine]\ncgroup_manager = "cgroupfs"\nevents_logger = "file"\n' > /etc/containers/containers.conf && \
    echo 'unqualified-search-registries = []' > /etc/containers/registries.conf.d/force-fully-qualified-images.conf

COPY --from=receptor /usr/bin/receptor /usr/bin/receptor

RUN pip3.12 install uv

COPY --from=awx-src requirements/requirements.txt requirements/requirements_git.txt requirements/requirements_dev.txt requirements/requirements_tower_uninstall.txt /tmp/requirements/

RUN uv venv --seed --python /usr/bin/python3.12 /var/lib/awx/venv/awx && \
    uv pip install --python /var/lib/awx/venv/awx/bin/python \
      -r /tmp/requirements/requirements.txt \
      -r /tmp/requirements/requirements_git.txt \
      -r /tmp/requirements/requirements_dev.txt \
      supervisor && \
    uv pip uninstall --python /var/lib/awx/venv/awx/bin/python -r /tmp/requirements/requirements_tower_uninstall.txt && \
    rm -rf /tmp/requirements /var/lib/awx/.cache

# awx code comes from the /awx_devel mount, not installed, so no console scripts either
RUN echo /awx_devel > /var/lib/awx/venv/awx/lib/python3.12/site-packages/awx.pth && \
    printf '#!/var/lib/awx/venv/awx/bin/python\nimport sys\nfrom awx import manage\n\nif __name__ == "__main__":\n    sys.exit(manage())\n' > /var/lib/awx/venv/awx/bin/awx-manage && \
    chmod +x /var/lib/awx/venv/awx/bin/awx-manage

RUN openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
      -keyout /etc/nginx/nginx.key -out /etc/nginx/nginx.crt \
      -subj "/CN=awx.localhost"

RUN mkdir -p \
      /var/lib/awx/projects \
      /var/lib/awx/public/static \
      /var/run/awx-receptor \
      /var/run/supervisor

WORKDIR /awx_devel

EXPOSE 8013 8043
