{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python -m tools.privacy_guard hook --harness claude --event pre-tool",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python -m tools.privacy_guard hook --harness claude --event post-tool",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
